{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feature/**": false,
      "bugfix/**": false,
      "dependabot/**": false,
      "claude/**": false
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "dota2-team-picker-web.vercel.app"
        }
      ],
      "destination": "https://www.dota2teampicker.com/:path*",
      "permanent": true
    }
  ]
}
