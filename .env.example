# Copy to .env.local and fill in from the Supabase dashboard (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key. Never the secret/service role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase user ids (Authentication > Users) that can open the admin pages, comma separated. Server only.
ADMIN_USER_IDS=
